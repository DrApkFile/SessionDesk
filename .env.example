MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Account A: community memory
MEMWAL_A_ACCOUNT_ID=0x...
MEMWAL_A_PRIVATE_KEY=...
# Account B: manager-only notes
MEMWAL_B_ACCOUNT_ID=0x...
MEMWAL_B_PRIVATE_KEY=...

TELEGRAM_MEMBER_BOT_TOKEN=...
TELEGRAM_MANAGER_BOT_TOKEN=...
# Your numeric Telegram user id(s), comma-separated. Get yours from @userinfobot.
MANAGER_TELEGRAM_IDS=123456789
# Numeric id of the community group (negative number). The member bot logs it when added to the group.
COMMUNITY_CHAT_ID=-1001234567890
# Short slug for this community, used as namespace prefix. Lowercase letters/digits, max 12.
COMMUNITY_KEY=c1
# Long random secret for HMAC namespaces. Never change it after members join.
NAMESPACE_SECRET=generate-with: openssl rand -hex 32

GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GROQ_API_KEY=...
GROQ_MODEL=qwen/qwen3.8-27b
