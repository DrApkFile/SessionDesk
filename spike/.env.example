# Walrus Memory account A (member side). Create at https://memory.walrus.xyz with wallet A.
MEMWAL_A_ACCOUNT_ID=0x...
MEMWAL_A_PRIVATE_KEY=...
# Walrus Memory account B (manager-only notes). Create with a DIFFERENT wallet B.
MEMWAL_B_ACCOUNT_ID=0x...
MEMWAL_B_PRIVATE_KEY=...
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Telegram bot tokens from @BotFather
TELEGRAM_MEMBER_BOT_TOKEN=...
TELEGRAM_MANAGER_BOT_TOKEN=...

# Model providers. Model names are required on purpose: copy the exact current
# model id from each provider's docs/console; the spike does not guess.
GROQ_API_KEY=...
GROQ_MODEL=...
GEMINI_API_KEY=...
GEMINI_MODEL=...
